# TrustToPay MCP Server Environment Configuration
# Copy to .env and supply your dedicated Agent API Key generated via POST /api/v1/auth/api-keys

# Base URL of the TrustToPay backend API
TRUSTTOPAY_API_BASE_URL=http://127.0.0.1:3000

# Dedicated Agent API Key (format: ttp_live_... or ttp_test_...)
TRUSTTOPAY_AGENT_API_KEY=ttp_test_replace_with_your_agent_api_key_000000

# Transport mode: "stdio" (default for local coding agents) or "http" (Streamable HTTP)
TRUSTTOPAY_MCP_TRANSPORT=stdio

# Streamable HTTP bind host & port (bound to 127.0.0.1 by default for local security)
TRUSTTOPAY_MCP_HOST=127.0.0.1
TRUSTTOPAY_MCP_PORT=3100

# Comma-separated allowed Origins for Streamable HTTP requests (optional)
TRUSTTOPAY_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-enforced budget policy bounds in USD minor units (cents)
TRUSTTOPAY_MCP_MIN_BUDGET_MINOR=500
TRUSTTOPAY_MCP_MAX_BUDGET_MINOR=50000

# Per-agent rate limit (requests per 60-second window)
TRUSTTOPAY_MCP_RATE_LIMIT_PER_MINUTE=60

# Request timeout in milliseconds when calling TrustToPay API
TRUSTTOPAY_MCP_TIMEOUT_MS=15000

# Automatically create/capture simulated funding and dispatch top-5 specialist offers on task creation
TRUSTTOPAY_MCP_AUTO_DISPATCH=true
