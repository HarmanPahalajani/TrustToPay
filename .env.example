# ==============================================================================
# TRUSTTOPAY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=4000
DATABASE_URL="file:./dev.db"
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
SESSION_SECRET=ttp_session_secret_change_this_to_32_random_characters_in_prod
DEMO_MODE=false
DEMO_USERS_ENABLED=true

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI UNIFIED AI PROVIDER (Confidence Evaluation & Code Review)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ESCALATION_THRESHOLD=0.75

# Optional legacy OpenAI-compatible settings (unused when AI_PROVIDER=gemini)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ------------------------------------------------------------------------------
# 3. JINA AI (Semantic Embeddings)
# ------------------------------------------------------------------------------
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# ------------------------------------------------------------------------------
# 4. ELASTICSEARCH (Intelligent Specialist Discovery)
# ------------------------------------------------------------------------------
ELASTIC_ENABLED=true
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTIC_INDEX_SPECIALISTS=trusttopay-specialists-v1
ELASTIC_TIMEOUT_MS=2500

# ------------------------------------------------------------------------------
# 5. PAYPAL SANDBOX INTEGRATION
# ------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PAYOUTS_ENABLED=false

# ------------------------------------------------------------------------------
# 6. SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 7. RESEND (Outbound Email Alerts)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=TrustToPay <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 8. CODE REVIEW & TASK LIMITS
# ------------------------------------------------------------------------------
CODE_REVIEW_ENABLED=true
CODE_REVIEW_FAIL_CLOSED=true
CODE_REVIEW_TIMEOUT_MS=30000
REWARD_MIN_MINOR=500
REWARD_MAX_MINOR=10000

# ------------------------------------------------------------------------------
# 9. TRUSTTOPAY MCP SERVER & AGENT INTEGRATION KIT
# ------------------------------------------------------------------------------
TRUSTTOPAY_API_BASE_URL=http://localhost:4000
TRUSTTOPAY_AGENT_API_KEY=
TRUSTTOPAY_MCP_TRANSPORT=stdio
TRUSTTOPAY_MCP_HOST=127.0.0.1
TRUSTTOPAY_MCP_PORT=3100
TRUSTTOPAY_MCP_ALLOWED_ORIGINS=http://localhost:5173
TRUSTTOPAY_MCP_MIN_BUDGET_MINOR=500
TRUSTTOPAY_MCP_MAX_BUDGET_MINOR=50000
TRUSTTOPAY_MCP_RATE_LIMIT_PER_MINUTE=60
TRUSTTOPAY_MCP_TIMEOUT_MS=15000
TRUSTTOPAY_MCP_AUTO_DISPATCH=true
